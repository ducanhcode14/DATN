# ==============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG BACKEND (EQUIPMENT MAINTENANCE SYSTEM)
# ==============================================================

# Cổng khởi chạy máy chủ Backend (mặc định: 5000)
PORT=5000

# Chuỗi kết nối cơ sở dữ liệu MongoDB
# Cục bộ (Local): mongodb://127.0.0.1:27017/equipment_maintenance
# Đám mây (Atlas): mongodb+srv://<user>:<password>@cluster0.mongodb.net/equipment_maintenance
MONGODB_URI=mongodb://127.0.0.1:27017/equipment_maintenance

# Khóa bí mật ký mã thông báo JSON Web Token (JWT)
JWT_SECRET=doantotnghiep_buiducanh_secret_key_2026

# Môi trường chạy ứng dụng: development | production
NODE_ENV=development
